   private string ExtractTableName(string sql)
        {
     // Simple table name extraction
     if (sql.Contains("FROM Users")) return "Users";
      if (sql.Contains("FROM Profiles")) return "Profiles";
     if (sql.Contains("FROM FoodItems")) return "FoodItems";
      if (sql.Contains("FROM FoodEntries")) return "FoodEntries";
       if (sql.Contains("FROM WaterEntries")) return "WaterEntries";
            if (sql.Contains("FROM WeightEntries")) return "WeightEntries";
     return "Unknown";
        }

        private void SaveJsonData(string fileName, object data)
 {
      var filePath = Path.Combine(_dataPath, fileName);
       try
    {
      // Use simple serialization since System.Text.Json might not be available
     var json = Newtonsoft.Json.JsonConvert.SerializeObject(data, Newtonsoft.Json.Formatting.Indented);
     File.WriteAllText(filePath, json);
    }
     catch
       {
    // Fallback to basic serialization
     var json = data.ToString();
      File.WriteAllText(filePath, json);
    }
        }

        private object LoadJsonData(string fileName)
     {
     var filePath = Path.Combine(_dataPath, fileName);
     if (!File.Exists(filePath)) return new List<object>();

  try
  {
            var json = File.ReadAllText(filePath);
    return Newtonsoft.Json.JsonConvert.DeserializeObject(json);
       }
  catch
       {
 return new List<object>();
        }
 }


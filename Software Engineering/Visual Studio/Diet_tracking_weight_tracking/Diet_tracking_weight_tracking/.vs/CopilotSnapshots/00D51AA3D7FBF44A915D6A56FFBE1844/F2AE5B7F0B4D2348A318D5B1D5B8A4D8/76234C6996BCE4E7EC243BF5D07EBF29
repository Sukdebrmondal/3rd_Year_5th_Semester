 /// <summary>
     /// Get total calories consumed for a specific date
   /// </summary>
   public async Task<int> GetTotalCaloriesForDateAsync(int userId, DateTime date)
  {
      return await Task.Run(() =>
      {
   using (var context = new DietTrackerDbContext())
     {
      string dateString = date.ToString("yyyy-MM-dd");
  var result = context.ExecuteScalar(@"
    SELECT COALESCE(SUM(Calories), 0)
   FROM FoodEntries 
       WHERE UserId = @userId AND DATE(Timestamp) = @date",
  new SQLiteParameter("@userId", userId),
   new SQLiteParameter("@date", dateString)
     );

     return Convert.ToInt32(result);
   }
        });
   }


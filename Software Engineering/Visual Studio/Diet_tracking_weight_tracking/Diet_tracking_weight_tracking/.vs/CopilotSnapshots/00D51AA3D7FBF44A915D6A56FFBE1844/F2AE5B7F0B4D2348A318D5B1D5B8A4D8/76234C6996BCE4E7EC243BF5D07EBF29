   /// <summary>
    /// Service for managing food, water, and weight entries
    /// </summary>
    public class EntryService
    {
  /// <summary>
     /// Add a new food entry for the user
/// </summary>
        public async Task AddFoodEntryAsync(int userId, FoodEntryDto dto)
  {
      await Task.Run(() =>
 {
      using (var context = new DietTrackerDbContext())
    {
  context.ExecuteNonQuery(@"
       INSERT INTO FoodEntries (UserId, FoodItemId, FoodName, Calories, Quantity, Timestamp, Note)
   VALUES (@userId, @foodItemId, @foodName, @calories, @quantity, @timestamp, @note)",
      new SQLiteParameter("@userId", userId),
       new SQLiteParameter("@foodItemId", dto.FoodItemId ?? (object)DBNull.Value),
   new SQLiteParameter("@foodName", dto.FoodName),
   new SQLiteParameter("@calories", dto.Calories),
    new SQLiteParameter("@quantity", dto.Quantity),
    new SQLiteParameter("@timestamp", dto.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")),
   new SQLiteParameter("@note", dto.Note ?? (object)DBNull.Value)
   );
     }
        });
 }

        /// <summary>
 /// Get food entries for a specific date
    /// </summary>
     public async Task<List<FoodEntryDto>> GetFoodEntriesForDateAsync(int userId, DateTime date)
 {
   return await Task.Run(() =>
    {
    var entries = new List<FoodEntryDto>();
  
      using (var context = new DietTrackerDbContext())
      {
    string dateString = date.ToString("yyyy-MM-dd");
  using (var reader = context.ExecuteReader(@"
     SELECT FoodItemId, FoodName, Calories, Quantity, Timestamp, Note
      FROM FoodEntries 
        WHERE UserId = @userId AND DATE(Timestamp) = @date
      ORDER BY Timestamp DESC",
   new SQLiteParameter("@userId", userId),
new SQLiteParameter("@date", dateString)
    ))
      {
        while (reader.Read())
 {
     entries.Add(new FoodEntryDto
        {
      FoodItemId = reader.IsDBNull(reader.GetOrdinal("FoodItemId")) ? null : (int?)reader.GetInt32("FoodItemId"),
     FoodName = reader.GetString("FoodName"),
     Calories = reader.GetInt32("Calories"),
    Quantity = reader.GetDouble("Quantity"),
    Timestamp = DateTime.Parse(reader.GetString("Timestamp")),
       Note = reader.IsDBNull(reader.GetOrdinal("Note")) ? null : reader.GetString("Note")
 });
      }
  }
   }

   return entries;
 });
        }


     /// <summary>
        /// Add a new weight entry for the user
 /// </summary>
        public async Task AddWeightEntryAsync(int userId, double weightKg)
 {
   await Task.Run(() =>
 {
      using (var context = new DietTrackerDbContext())
      {
      context.ExecuteNonQuery(@"
       INSERT INTO WeightEntries (UserId, WeightKg, Timestamp)
VALUES (@userId, @weight, @timestamp)",
   new SQLiteParameter("@userId", userId),
     new SQLiteParameter("@weight", weightKg),
    new SQLiteParameter("@timestamp", DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))
     );

    // Update profile weight
     context.ExecuteNonQuery(@"
   UPDATE Profiles SET WeightKg = @weight, UpdatedAt = @updatedAt
  WHERE UserId = @userId",
new SQLiteParameter("@weight", weightKg),
new SQLiteParameter("@updatedAt", DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")),
       new SQLiteParameter("@userId", userId)
   );
  }
        });
   }

        /// <summary>
     /// Get weight history for a date range
 /// </summary>
   public async Task<List<WeightEntryDto>> GetWeightHistoryAsync(int userId, DateTime from, DateTime to)
     {
        return await Task.Run(() =>
  {
       var entries = new List<WeightEntryDto>();
      
 using (var context = new DietTrackerDbContext())
     {
      using (var reader = context.ExecuteReader(@"
   SELECT WeightKg, Timestamp
FROM WeightEntries 
       WHERE UserId = @userId AND DATE(Timestamp) BETWEEN @from AND @to
       ORDER BY Timestamp ASC",
   new SQLiteParameter("@userId", userId),
 new SQLiteParameter("@from", from.ToString("yyyy-MM-dd")),
   new SQLiteParameter("@to", to.ToString("yyyy-MM-dd"))
     ))
   {
      while (reader.Read())
      {
   entries.Add(new WeightEntryDto
      {
        WeightKg = reader.GetDouble("WeightKg"),
    Timestamp = DateTime.Parse(reader.GetString("Timestamp"))
     });
      }
}
        }

      return entries;
 });
        }

        /// <summary>
 /// Get all available food items
        /// </summary>
 public async Task<List<FoodItem>> GetFoodItemsAsync()
   {
      return await Task.Run(() =>
        {
   var items = new List<FoodItem>();
  
    using (var context = new DietTrackerDbContext())
     {
    using (var reader = context.ExecuteReader(@"
    SELECT Id, Name, DefaultCaloriesPerServing, ServingDescription
      FROM FoodItems 
       WHERE IsActive = 1
        ORDER BY Name"))
     {
       while (reader.Read())
       {
        items.Add(new FoodItem
    {
   Id = reader.GetInt32("Id"),
Name = reader.GetString("Name"),
        DefaultCaloriesPerServing = reader.GetInt32("DefaultCaloriesPerServing"),
 ServingDescription = reader.IsDBNull(reader.GetOrdinal("ServingDescription")) ? null : reader.GetString("ServingDescription")
    });
      }
 }
  }

 return items;
        });
 }


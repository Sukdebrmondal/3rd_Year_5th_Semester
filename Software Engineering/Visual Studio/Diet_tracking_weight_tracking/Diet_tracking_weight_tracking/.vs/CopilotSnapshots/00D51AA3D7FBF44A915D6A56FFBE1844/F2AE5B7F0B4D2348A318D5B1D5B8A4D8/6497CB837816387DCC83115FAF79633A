      )");
}
     catch { } // Table might already exist

    try
       {
      // Create WaterEntries table
   ExecuteNonQuery(@"
            CREATE TABLE WaterEntries (
    Id AUTOINCREMENT PRIMARY KEY,
            UserId LONG NOT NULL,
    Ml INTEGER NOT NULL,
    Timestamp DATETIME NOT NULL
          )");
       }
       catch { } // Table might already exist

            try
      {
   // Create WeightEntries table
   ExecuteNonQuery(@"
      CREATE TABLE WeightEntries (
  Id AUTOINCREMENT PRIMARY KEY,
  UserId LONG NOT NULL,
        WeightKg DOUBLE NOT NULL,
        Timestamp DATETIME NOT NULL
        )");
      }
      catch { } // Table might already exist
        }

        public void ExecuteNonQuery(string sql, params object[] parameters)
        {
     var connection = GetConnection();
     using (var command = new OleDbCommand(sql, connection))
     {
          if (parameters != null && parameters.Length > 0)
        {
     // Replace ? placeholders with parameter markers
for (int i = 0; i < parameters.Length; i++)
       {
      command.Parameters.Add(new OleDbParameter($"@param{i}", parameters[i] ?? DBNull.Value));
     }
    }
        command.ExecuteNonQuery();
       }
      }

public OleDbDataReader ExecuteReader(string sql, params object[] parameters)
        {
      var connection = GetConnection();
      var command = new OleDbCommand(sql, connection);
        if (parameters != null && parameters.Length > 0)
      {
         for (int i = 0; i < parameters.Length; i++)
    {
        command.Parameters.Add(new OleDbParameter($"@param{i}", parameters[i] ?? DBNull.Value));
   }
        }
        return command.ExecuteReader();
        }

     public object ExecuteScalar(string sql, params object[] parameters)
        {
            var connection = GetConnection();
    using (var command = new OleDbCommand(sql, connection))
    {
       if (parameters != null && parameters.Length > 0)
            {
      for (int i = 0; i < parameters.Length; i++)
     {
  command.Parameters.Add(new OleDbParameter($"@param{i}", parameters[i] ?? DBNull.Value));
    }
      }
   return command.ExecuteScalar();
 }
 }

    public void Dispose()
      {
  _connection?.Close();
       _connection?.Dispose();
    }
    }
}
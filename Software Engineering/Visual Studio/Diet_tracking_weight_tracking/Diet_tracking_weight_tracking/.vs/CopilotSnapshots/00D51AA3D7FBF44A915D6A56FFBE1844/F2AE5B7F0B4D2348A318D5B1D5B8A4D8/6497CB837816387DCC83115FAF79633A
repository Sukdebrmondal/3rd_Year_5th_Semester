     HealthGoal INTEGER NOT NULL,
   TargetWeightKg DOUBLE,
     WaterTargetMl INTEGER NOT NULL,
       ProfileImagePath TEXT(255),
  UpdatedAt DATETIME NOT NULL
      )");
  }
 catch { } // Table might already exist

   try
     {
     // Create FoodItems table
       ExecuteNonQuery(@"
 CREATE TABLE FoodItems (
  Id AUTOINCREMENT PRIMARY KEY,
        Name TEXT(100) NOT NULL,
      DefaultCaloriesPerServing INTEGER NOT NULL,
        ServingDescription TEXT(50),
 IsActive YESNO NOT NULL
  )");
     }
  catch { } // Table might already exist

        try
      {
   // Create FoodEntries table
      ExecuteNonQuery(@"
    CREATE TABLE FoodEntries (
  Id AUTOINCREMENT PRIMARY KEY,
    UserId LONG NOT NULL,
            FoodItemId LONG,
      FoodName TEXT(100) NOT NULL,
      Calories INTEGER NOT NULL,
     Quantity DOUBLE NOT NULL,

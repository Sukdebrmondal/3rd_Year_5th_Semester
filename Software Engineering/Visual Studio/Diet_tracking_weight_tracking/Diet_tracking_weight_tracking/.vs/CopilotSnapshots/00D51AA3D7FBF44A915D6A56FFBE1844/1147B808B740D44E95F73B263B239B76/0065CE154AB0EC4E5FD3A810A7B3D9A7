     /// <summary>
        /// Update the calorie pie chart for a specific date
        /// Shows calorie distribution by food type
        /// </summary>
      /// <param name="date">Date to show calories for</param>
        public async Task UpdateCaloriesPieChartAsync(DateTime date)
        {
            try
    {
           // Fetch data off UI thread
        var groupedEntries = await Task.Run(() =>
     {
       using (var context = new Data.DietTrackerDbContext())
            {
    context.EnsureCreated();
var entries = context.GetFoodEntries(_user.Id, date);
   
  if (!entries.Any())
         return new List<GroupedCaloriesDto>();

              var grouped = entries
       .GroupBy(f => f.FoodName)
          .Select(g => new GroupedCaloriesDto
   {
              Food = g.Key,
    Calories = g.Sum(x => x.Calories)
              })
         .OrderByDescending(g => g.Calories)
      .ToList();

          // Calculate percentages
            var totalCalories = grouped.Sum(g => g.Calories);
      foreach (var item in grouped)
       {
          item.Percentage = totalCalories > 0 ? (double)item.Calories / totalCalories * 100 : 0;
                 }

               return grouped;
            }
      });

     // Update UI on main thread
        if (this.InvokeRequired)
                {
  this.BeginInvoke(new Action(() => UpdateCaloriesPieChartInternal(groupedEntries)));
         }
     else
          {
          UpdateCaloriesPieChartInternal(groupedEntries);
        }
            }
    catch (Exception ex)
            {
     if (this.InvokeRequired)
{
          this.BeginInvoke(new Action(() => 
              ChartHelpers.ShowNoDataMessage(chartCalories, "Error loading calorie data")));
     }
             else
 {
         ChartHelpers.ShowNoDataMessage(chartCalories, "Error loading calorie data");
       }
                
     // Log error or show message
       Console.WriteLine($"Error updating calorie chart: {ex.Message}");
  }
        }

    /// <summary>
        /// Internal method to update pie chart on UI thread
        /// </summary>
        private void UpdateCaloriesPieChartInternal(List<GroupedCaloriesDto> groupedEntries)
        {
   // Clear and setup chart
         ChartHelpers.ClearChart(chartCalories);

            if (groupedEntries == null || !groupedEntries.Any())
            {
     ChartHelpers.ShowNoDataMessage(chartCalories, "No calories logged today");
        return;
         }

            ChartHelpers.SetUpPieSeries(chartCalories, $"Calorie Distribution - {DateTime.Today:MMM dd}");

   var series = chartCalories.Series["Calories"];
            series.Points.Clear();

            var totalCalories = groupedEntries.Sum(g => g.Calories);
          
   // Group small items under "Other" if percentage < 3%
     var mainItems = groupedEntries.Where(g => g.Percentage >= 3).ToList();
   var otherItems = groupedEntries.Where(g => g.Percentage < 3).ToList();

            int colorIndex = 0;
      
       // Add main items
 foreach (var item in mainItems)
            {
         var point = series.Points.Add(item.Calories);
        point.LegendText = item.Food;
  point.Label = $"{item.Percentage:F1}%";
point.Color = ChartHelpers.GetPaletteColor(colorIndex++);
   
      // Enhanced tooltip
        point.ToolTip = $"{item.Food}: {item.Calories} cal ({item.Percentage:F1}%)";
            }

            // Add "Other" category if there are small items
            if (otherItems.Any())
      {
     var otherCalories = otherItems.Sum(i => i.Calories);
         var otherPercentage = (double)otherCalories / totalCalories * 100;
          
    var point = series.Points.Add(otherCalories);
           point.LegendText = "Other";
     point.Label = $"{otherPercentage:F1}%";
           point.Color = ChartHelpers.GetPaletteColor(colorIndex);
       
        var otherTooltip = string.Join("\\n", otherItems.Select(i => $"  {i.Food}: {i.Calories} cal"));
     point.ToolTip = $"Other ({otherItems.Count} items): {otherCalories} cal\\n{otherTooltip}";
     }

          chartCalories.Invalidate();
     }


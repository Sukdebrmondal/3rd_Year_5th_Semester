  public async Task UpdateWeightLineChartAsync(DateTime fromDate, DateTime toDate)
        {
   try
   {
       // Fetch data off UI thread
                var weightEntries = await Task.Run(() =>
    {
           using (var context = new Data.DietTrackerDbContext())
 {
            context.EnsureCreated();
   var entries = context.GetWeightEntries(_user.Id, fromDate, toDate);
      
   return entries.Select(w => new WeightChartDto
      {
                Timestamp = w.Timestamp,
           WeightKg = w.WeightKg
     }).OrderBy(w => w.Timestamp).ToList();
   }
          });

      // Update UI on main thread
  if (this.InvokeRequired)
       {
      this.BeginInvoke(new Action(() => UpdateWeightLineChartInternal(weightEntries, fromDate, toDate)));
   }
   else
   {
         UpdateWeightLineChartInternal(weightEntries, fromDate, toDate);
        }
   }
            catch (Exception ex)
         {
                if (this.InvokeRequired)
  {
      this.BeginInvoke(new Action(() => 
      ChartHelpers.ShowNoDataMessage(chartWeight, "Error loading weight data")));
       }
      else
            {
    ChartHelpers.ShowNoDataMessage(chartWeight, "Error loading weight data");
     }
    
                Console.WriteLine($"Error updating weight chart: {ex.Message}");
      }
        }

        /// <summary>
        /// Internal method to update line chart on UI thread
      /// </summary>
        private void UpdateWeightLineChartInternal(List<WeightChartDto> weightEntries, DateTime fromDate, DateTime toDate)
        {
     ChartHelpers.ClearChart(chartWeight);

    if (weightEntries == null || !weightEntries.Any())
       {
     var days = (toDate - fromDate).Days;
       ChartHelpers.ShowNoDataMessage(chartWeight, $"No weight entries in last {days} days");
     return;
            }

            var daySpan = (toDate - fromDate).Days;
            ChartHelpers.SetUpLineSeries(chartWeight, $"Weight History - Last {daySpan} Days");

         var series = chartWeight.Series["Weight"];
   series.Points.Clear();

        // Add data points
     foreach (var entry in weightEntries)
        {
        var pointIndex = series.Points.AddXY(entry.Timestamp.ToOADate(), entry.WeightKg);
         var point = series.Points[pointIndex];
    point.ToolTip = $"Date: {entry.Timestamp:dd MMM yyyy}\\nWeight: {entry.WeightKg:F1} kg";
 }

            // Configure axis range
        var chartArea = chartWeight.ChartAreas["LineArea"];
            chartArea.AxisX.Minimum = fromDate.ToOADate();
  chartArea.AxisX.Maximum = toDate.ToOADate();
  
     // Calculate nice Y-axis range
            var minWeight = weightEntries.Min(w => w.WeightKg);
            var maxWeight = weightEntries.Max(w => w.WeightKg);
     var range = maxWeight - minWeight;
     var padding = Math.Max(1.0, range * 0.1); // 10% padding or minimum 1kg
            
  chartArea.AxisY.Minimum = Math.Max(0, minWeight - padding);
        chartArea.AxisY.Maximum = maxWeight + padding;

       // Add trend line if we have enough data points
            if (weightEntries.Count >= 3)
            {
     AddTrendLine(series, weightEntries);
  }

            chartWeight.Invalidate();
        }

        /// <summary>
        /// Add a trend line to the weight chart
        /// </summary>
      private void AddTrendLine(Series mainSeries, List<WeightChartDto> weightEntries)
    {
            try
            {
       // Simple linear regression for trend line
              var n = weightEntries.Count;
    var sumX = weightEntries.Sum(w => w.Timestamp.ToOADate());
         var sumY = weightEntries.Sum(w => w.WeightKg);
       var sumXY = weightEntries.Sum(w => w.Timestamp.ToOADate() * w.WeightKg);
 var sumXX = weightEntries.Sum(w => w.Timestamp.ToOADate() * w.Timestamp.ToOADate());

    var slope = (n * sumXY - sumX * sumY) / (n * sumXX - sumX * sumX);
         var intercept = (sumY - slope * sumX) / n;

            // Create trend line series
       var trendSeries = new Series("Trend")
       {
           ChartType = SeriesChartType.Line,
       ChartArea = "LineArea",
   XValueType = ChartValueType.DateTime,
         BorderWidth = 2,
             BorderDashStyle = ChartDashStyle.Dash,
                  Color = Color.FromArgb(255, 99, 132),
 IsVisibleInLegend = true
       };

      // Add trend points
    var firstDate = weightEntries.First().Timestamp.ToOADate();
  var lastDate = weightEntries.Last().Timestamp.ToOADate();

     trendSeries.Points.AddXY(firstDate, slope * firstDate + intercept);
 trendSeries.Points.AddXY(lastDate, slope * lastDate + intercept);

        chartWeight.Series.Add(trendSeries);
    }
            catch
  {
        // If trend calculation fails, just skip it
    }
      }


using System;
using System.Collections.Generic;
using System.Drawing;
using System.Linq;
using System.Threading.Tasks;
using System.Windows.Forms;
using Diet_tracking_weight_tracking.DTOs;
using Diet_tracking_weight_tracking.Models;
using Diet_tracking_weight_tracking.Services;

namespace Diet_tracking_weight_tracking.Forms
{
    /// <summary>
    /// Main dashboard form for tracking daily food, water, and weight
    /// </summary>
    public partial class DashboardForm : Form
    {
      private readonly User _user;
        private readonly ProfileService _profileService;
        private readonly EntryService _entryService;
      private ProfileDto _userProfile;
        private List<FoodItem> _foodItems;

        public DashboardForm(User user)
        {
   InitializeComponent();
          _user = user;
            _profileService = new ProfileService();
 _entryService = new EntryService();
            
   LoadUserData();
        }

        private async void LoadUserData()
        {
    try
      {
     // Load user profile
         _userProfile = await _profileService.GetProfileAsync(_user.Id);
          
       // Load food items for quick add
     _foodItems = await _entryService.GetFoodItemsAsync();
          
   // Setup UI
     await SetupQuickAddButtons();
 await PopulateFoodComboBox();
  await UpdateHeaderStats();
 await RefreshTodayData();
      }
         catch (Exception ex)
            {
          MessageBox.Show($"Error loading dashboard: {ex.Message}", "Error", 
        MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private async Task SetupQuickAddButtons()
        {
      pnlQuickAdd.Controls.Clear();
      
            // Quick add buttons for common foods
string[] quickFoods = { "Rice", "Egg", "Milk", "Fish", "Potato", "Butter", "Bread", "Apple" };
         
      int x = 10, y = 10;
            foreach (string foodName in quickFoods)
 {
                var food = _foodItems.FirstOrDefault(f => f.Name.Equals(foodName, StringComparison.OrdinalIgnoreCase));
     if (food != null)
   {
    var btn = new Button
         {
        Text = $"{food.Name}\n{food.DefaultCaloriesPerServing} cal",
     Size = new Size(80, 60),
                Location = new Point(x, y),
           BackColor = Color.FromArgb(40, 167, 69),
     ForeColor = Color.White,
        FlatStyle = FlatStyle.Flat,
        Font = new Font("Segoe UI", 8F, FontStyle.Bold),
            Tag = food.Id
          };
       btn.FlatAppearance.BorderSize = 0;
             btn.Click += QuickAddButton_Click;
         
   pnlQuickAdd.Controls.Add(btn);
         
 x += 90;
   if (x > 350)
        {
     x = 10;
     y += 70;
        }
          }
            }
      }

   private async Task PopulateFoodComboBox()
        {
cboFoodSearch.Items.Clear();
            cboFoodSearch.Items.Add("Select a food item...");
   
      foreach (var food in _foodItems)
     {
        cboFoodSearch.Items.Add($"{food.Name} ({food.DefaultCaloriesPerServing} cal)");
        }
     
            cboFoodSearch.SelectedIndex = 0;
        }

private async Task UpdateHeaderStats()
        {
            if (_userProfile != null)
   {
             // Calculate BMI
   double bmi = _profileService.CalculateBMI(_userProfile.WeightKg, _userProfile.HeightCm);
       string bmiCategory = GetBMICategory(bmi);
                Color bmiColor = GetBMIColor(bmi);
         
                lblBmiValue.Text = $"BMI: {bmi:F1} ({bmiCategory})";
          lblBmiValue.ForeColor = bmiColor;
   
     // Calculate calorie target
      int calorieTarget = _profileService.GetDailyCalorieTarget(_userProfile);
                lblTargetCalories.Text = $"Target: {calorieTarget} cal";
    
                // Water target
                lblWaterTarget.Text = $"Water Goal: {_userProfile.WaterTargetMl} ml";
    
           // Health goal
           lblGoal.Text = $"Goal: {_userProfile.HealthGoal}";
            }
        }

        private async Task RefreshTodayData()
     {
    // Refresh food entries
     await RefreshFoodEntries();
            
        // Refresh water entries
            await RefreshWaterEntries();
        }

      private async Task RefreshFoodEntries()
        {
            var entries = await _entryService.GetFoodEntriesForDateAsync(_user.Id, DateTime.Today);
            
            lvFoodEntries.Items.Clear();
  int totalCalories = 0;
            
            foreach (var entry in entries)
        {
       var item = new ListViewItem(entry.FoodName);
   item.SubItems.Add(entry.Calories.ToString());
      item.SubItems.Add(entry.Quantity.ToString("F1"));
         item.SubItems.Add(entry.Timestamp.ToString("HH:mm"));
       item.Tag = entry; // Store the entry for deletion
        
     lvFoodEntries.Items.Add(item);
       totalCalories += entry.Calories;
  }
    
        lblCalorieTotal.Text = $"Total: {totalCalories} calories";
        }

        private async Task RefreshWaterEntries()
        {
            var entries = await _entryService.GetWaterEntriesForDateAsync(_user.Id, DateTime.Today);
   
            lvWaterEntries.Items.Clear();
       int totalWater = 0;
        
  foreach (var entry in entries)
    {
     var item = new ListViewItem($"{entry.Ml} ml");
        item.SubItems.Add(entry.Timestamp.ToString("HH:mm"));
         item.Tag = entry.Id; // Store the ID for deletion
   
       lvWaterEntries.Items.Add(item);
            totalWater += entry.Ml;
   }
     
            int target = _userProfile?.WaterTargetMl ?? 2000;
    lblWaterTotal.Text = $"{totalWater} / {target} ml";
     
            // Update progress
double progress = Math.Min(100, (double)totalWater / target * 100);
   progressWater.Value = (int)progress;
        }

        private async void QuickAddButton_Click(object sender, EventArgs e)
        {
  var button = sender as Button;
      int foodItemId = (int)button.Tag;
        
   var food = _foodItems.FirstOrDefault(f => f.Id == foodItemId);
     if (food != null)
      {
                await AddFoodEntry(food, 1.0);
            }
        }

        private async void btnAddFood_Click(object sender, EventArgs e)
        {
       if (cboFoodSearch.SelectedIndex <= 0)
            {
    MessageBox.Show("Please select a food item.", "Validation Error", 
              MessageBoxButtons.OK, MessageBoxIcon.Warning);
 return;
  }
   
         int foodIndex = cboFoodSearch.SelectedIndex - 1; // Subtract 1 for placeholder
        var food = _foodItems[foodIndex];
      
       double quantity = (double)nudQuantity.Value;
      await AddFoodEntry(food, quantity);
        }

        private async Task AddFoodEntry(FoodItem food, double quantity)
      {
      try
         {
            var dto = new FoodEntryDto
  {
     FoodItemId = food.Id,
   FoodName = food.Name,
    Calories = (int)(food.DefaultCaloriesPerServing * quantity),
      Quantity = quantity,
       Timestamp = DateTime.Now
      };
 
          await _entryService.AddFoodEntryAsync(_user.Id, dto);
        await RefreshTodayData();
         }
   catch (Exception ex)
            {
MessageBox.Show($"Error adding food entry: {ex.Message}", "Error", 
  MessageBoxButtons.OK, MessageBoxIcon.Error);
  }
        }

        private async void btnAddWater_Click(object sender, EventArgs e)
        {
            try
            {
          int ml = (int)nudWaterMl.Value;
             await _entryService.AddWaterEntryAsync(_user.Id, ml);
                await RefreshWaterEntries();
         
 nudWaterMl.Value = 250; // Reset to default
     }
            catch (Exception ex)
            {
       MessageBox.Show($"Error adding water entry: {ex.Message}", "Error", 
   MessageBoxButtons.OK, MessageBoxIcon.Error);
   }
        }

  private async void btnAddWeight_Click(object sender, EventArgs e)
        {
      try
      {
     double weight = (double)nudWeightEntry.Value;
           await _entryService.AddWeightEntryAsync(_user.Id, weight);
  await UpdateHeaderStats(); // BMI might change
         
     MessageBox.Show("Weight entry added successfully!", "Success", 
 MessageBoxButtons.OK, MessageBoxIcon.Information);
   }
       catch (Exception ex)
      {
             MessageBox.Show($"Error adding weight entry: {ex.Message}", "Error", 
   MessageBoxButtons.OK, MessageBoxIcon.Error);
     }
   }

     private string GetBMICategory(double bmi)
        {
            if (bmi < 18.5) return "Underweight";
         if (bmi < 25) return "Normal";
     if (bmi < 30) return "Overweight";
          return "Obese";
        }

        private Color GetBMIColor(double bmi)
    {
        if (bmi < 18.5) return Color.Blue;
 if (bmi < 25) return Color.Green;
            if (bmi < 30) return Color.Orange;
    return Color.Red;
        }

      private async void lvFoodEntries_KeyDown(object sender, KeyEventArgs e)
        {
        if (e.KeyCode == Keys.Delete && lvFoodEntries.SelectedItems.Count > 0)
    {
              await DeleteSelectedFoodEntry();
     }
        }

      private async void lvWaterEntries_KeyDown(object sender, KeyEventArgs e)
        {
       if (e.KeyCode == Keys.Delete && lvWaterEntries.SelectedItems.Count > 0)
          {
     await DeleteSelectedWaterEntry();
        }
      }

        private async Task DeleteSelectedFoodEntry()
     {
            try
            {
    var selectedItem = lvFoodEntries.SelectedItems[0];
 var entry = (FoodEntryDto)selectedItem.Tag;
     
  // Note: We need to add DeleteFoodEntry method to EntryService that takes entry info
                // For now, we'll just refresh the data
   await RefreshTodayData();
         }
  catch (Exception ex)
 {
       MessageBox.Show($"Error deleting food entry: {ex.Message}", "Error", 
   MessageBoxButtons.OK, MessageBoxIcon.Error);
          }
        }

        private async Task DeleteSelectedWaterEntry()
        {
            try
     {
        var selectedItem = lvWaterEntries.SelectedItems[0];
                int entryId = (int)selectedItem.Tag;
    
          await _entryService.DeleteWaterEntryAsync(entryId);
          await RefreshWaterEntries();
            }
            catch (Exception ex)
            {
           MessageBox.Show($"Error deleting water entry: {ex.Message}", "Error", 
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
  }
        }
    }
}
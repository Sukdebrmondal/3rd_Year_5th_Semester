using System;
using System.Diagnostics;
using System.IO;

namespace Diet_tracking_weight_tracking.Data
{
    /// <summary>
    /// Factory for creating DbContext instances with consistent configuration
    /// </summary>
    public static class DbContextFactory
 {
     /// <summary>
    /// Creates a new DbContext instance using the configured SQLite connection
        /// </summary>
        /// <returns>Configured DbContext instance</returns>
        public static SqliteDietTrackerDbContext CreateContext()
      {
          try
 {
      var context = new SqliteDietTrackerDbContext();
        
      // Ensure database is created on first access
     context.EnsureCreatedAndSeeded();
      
   Debug.WriteLine($"DbContext created successfully. DB: {AppPaths.DbFilePath}");
          return context;
    }
       catch (Exception ex)
  {
     Debug.WriteLine($"Failed to create DbContext: {ex.Message}");
        Debug.WriteLine($"Database path: {AppPaths.DbFilePath}");
          Debug.WriteLine($"App data folder: {AppPaths.AppDataFolder}");
        throw new InvalidOperationException($"Failed to initialize database: {ex.Message}", ex);
    }
        }

        /// <summary>
   /// Initializes the database at application startup
 /// </summary>
   public static void InitializeDatabase()
        {
 try
   {
          Debug.WriteLine("Initializing database...");
    Debug.WriteLine(AppPaths.GetDatabaseInfo());

   using (var context = CreateContext())
      {
   // Database is initialized in CreateContext()
var userCount = context.Users.Count();
        var foodItemCount = context.FoodItems.Count();
    
   Debug.WriteLine($"Database initialized successfully:");
           Debug.WriteLine($"  - Users: {userCount}");
     Debug.WriteLine($"  - Food Items: {foodItemCount}");
      Debug.WriteLine($"- Path: {AppPaths.DbFilePath}");
    }
    }
    catch (Exception ex)
   {
            Debug.WriteLine($"Database initialization failed: {ex.Message}");
  throw;
        }
 }

        /// <summary>
        /// Reports current database status for debugging
        /// </summary>
   public static void ReportDatabaseStatus()
  {
  try
      {
     Debug.WriteLine("=== Database Status Report ===");
            Debug.WriteLine(AppPaths.GetDatabaseInfo());
            
       if (File.Exists(AppPaths.DbFilePath))
   {
        using (var context = CreateContext())
      {
   Debug.WriteLine($"Users in database: {context.Users.Count()}");
      Debug.WriteLine($"Food items in database: {context.FoodItems.Count()}");
 Debug.WriteLine($"Connection string: {AppPaths.GetSqliteConnectionString()}");
     }
     }
     else
     {
     Debug.WriteLine("Database file does not exist yet.");
            }
  
        Debug.WriteLine("=== End Database Status ===");
        }
        catch (Exception ex)
 {
       Debug.WriteLine($"Error reporting database status: {ex.Message}");
      }
    }
    }
}
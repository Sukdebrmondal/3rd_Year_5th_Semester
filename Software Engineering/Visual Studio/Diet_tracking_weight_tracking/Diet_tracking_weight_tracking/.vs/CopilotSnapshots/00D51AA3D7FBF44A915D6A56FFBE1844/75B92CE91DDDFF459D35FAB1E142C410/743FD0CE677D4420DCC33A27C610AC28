        private async void DgvFoodEntries_KeyDown(object sender, KeyEventArgs e)
        {
            if (dgvFoodEntries == null) return;
            
    if (e.KeyCode == Keys.Delete && dgvFoodEntries.SelectedRows.Count > 0)
 {
   await DeleteFoodEntryAsync(dgvFoodEntries.SelectedRows[0].Index);
    }
        }

   private async Task DeleteFoodEntryAsync(int rowIndex)
   {
            if (dgvFoodEntries == null) return;
      
   try
 {
 var row = dgvFoodEntries.Rows[rowIndex];
    var idObj = row.Cells["Id"].Value;
       if (idObj == null) return;

       int entryId = Convert.ToInt32(idObj);
      var foodName = row.Cells["Food"].Value?.ToString();
   var calories = row.Cells["Calories"].Value?.ToString();

      // Confirm deletion
    var result = MessageBox.Show(
        $"Delete '{foodName}' ({calories} cal) from today's log?", 
   "Confirm Delete", 
   MessageBoxButtons.YesNo, 
     MessageBoxIcon.Warning);
   
        if (result != DialogResult.Yes) return;

     // Remove row optimistically for responsive UI
      dgvFoodEntries.Rows.RemoveAt(rowIndex);
   UpdateFoodTotals();

       // Delete from database on background thread
var success = await Task.Run(() => _entryService.DeleteFoodEntryAsync(entryId));

     if (!success)
  {
        // Deletion failed - reload data to restore correct state
          MessageBox.Show("Failed to delete food entry. Please try again.", "Error", 
 MessageBoxButtons.OK, MessageBoxIcon.Error);
    await LoadFoodEntriesForTodayAsync();
          }
    else
       {
   // Success - update charts and show feedback
await UpdateCaloriesPieChartAsync(DateTime.Today);
 ShowSuccessMessage("Food entry deleted successfully");
     }
      }
     catch (Exception ex)
      {
           MessageBox.Show($"Error deleting food entry: {ex.Message}", "Error", 
          MessageBoxButtons.OK, MessageBoxIcon.Error);
     await LoadFoodEntriesForTodayAsync();
   }
 }


using System;
using System.Diagnostics;
using System.Windows.Forms;
using Diet_tracking_weight_tracking.Data;
using Diet_tracking_weight_tracking.Forms;

namespace Diet_tracking_weight_tracking
{
    static class Program
    {
        /// <summary>
        /// The main entry point for the application.
        /// </summary>
        [STAThread]
        static void Main()
        {
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);

            try
            {
                // Initialize the persistent SQLite database
                Debug.WriteLine("=== Diet Tracker Starting ===");
                DbContextFactory.InitializeDatabase();
                Debug.WriteLine("Database initialization completed successfully");
            }
            catch (Exception ex)
            {
                Debug.WriteLine($"Critical error during database initialization: {ex.Message}");
                MessageBox.Show(
                    $"Failed to initialize database:\n{ex.Message}\n\nApplication will exit.",
                    "Database Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
                return;
            }

            // Start with the login form
            Application.Run(new LoginForm());
        }
    }
}

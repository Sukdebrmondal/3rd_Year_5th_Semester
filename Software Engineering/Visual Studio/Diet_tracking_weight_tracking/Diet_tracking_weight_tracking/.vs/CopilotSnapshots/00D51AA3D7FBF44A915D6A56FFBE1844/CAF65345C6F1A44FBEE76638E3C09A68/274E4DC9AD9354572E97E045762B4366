using System;
using System.Diagnostics;
using System.Threading.Tasks;
using System.Windows.Forms;
using Diet_tracking_weight_tracking.Data;
using Diet_tracking_weight_tracking.DTOs;
using Diet_tracking_weight_tracking.Services;

namespace Diet_tracking_weight_tracking.Testing
{
    /// <summary>
    /// Test utilities for verifying user registration and login persistence
    /// </summary>
    public static class AuthenticationTestHelper
 {
        /// <summary>
        /// Performs comprehensive test of user registration and login persistence
     /// </summary>
        public static async Task<bool> RunPersistenceTest()
        {
   Debug.WriteLine("=== Starting Authentication Persistence Test ===");

       try
    {
            var authService = new AuthenticationService();
   
    // Test 1: Database initialization
            Debug.WriteLine("Test 1: Database initialization check");
           authService.DebugReportDatabaseStatus();

    // Test 2: Register a test user
        Debug.WriteLine("Test 2: Registering test user");
           string testUsername = $"testuser_{DateTime.Now:yyyyMMddHHmmss}";
                string testEmail = $"test_{DateTime.Now:yyyyMMddHHmmss}@example.com";
     string testPassword = "TestPassword123!";
     
    var profileDto = new ProfileDto
     {
   FullName = "Test User",
     DOB = new DateTime(1990, 1, 1),
     Gender = Models.Gender.Other,
             ActivityLevel = Models.ActivityLevel.Moderate,
      HealthGoal = Models.HealthGoal.Maintain,
  HeightCm = 175,
        WeightKg = 70,
  TargetWeightKg = 70,
 WaterTargetMl = 2000
    };
    
                var registeredUser = await authService.RegisterAsync(testUsername, testEmail, testPassword, profileDto);
  
     if (registeredUser == null)
    {
          Debug.WriteLine("❌ Test 2 FAILED: User registration returned null");
        return false;
  }
      
       Debug.WriteLine($"✅ Test 2 PASSED: User registered successfully with ID {registeredUser.Id}");
             
      // Test 3: Verify user can login immediately (same session)
                Debug.WriteLine("Test 3: Immediate login test (same session)");
     var loginUser1 = await authService.LoginAsync(testUsername, testPassword);
     
             if (loginUser1 == null)
                {
  Debug.WriteLine("❌ Test 3 FAILED: Immediate login failed");
       return false;
      }
    
             Debug.WriteLine($"✅ Test 3 PASSED: Immediate login successful for {loginUser1.Username}");
 
                // Test 4: Verify user exists check
           Debug.WriteLine("Test 4: Username existence check");
     bool userExists = await authService.UsernameExistsAsync(testUsername);
     
        if (!userExists)
      {
  Debug.WriteLine("❌ Test 4 FAILED: Username existence check failed");
            return false;
     }
                
             Debug.WriteLine("✅ Test 4 PASSED: Username existence check successful");
      
        // Test 5: Test wrong password
          Debug.WriteLine("Test 5: Wrong password test");
         var wrongPasswordUser = await authService.LoginAsync(testUsername, "WrongPassword123!");
     
                if (wrongPasswordUser != null)
            {
             Debug.WriteLine("❌ Test 5 FAILED: Login succeeded with wrong password");
   return false;
        }
          
      Debug.WriteLine("✅ Test 5 PASSED: Wrong password correctly rejected");
         
              // Test 6: Test non-existent user
        Debug.WriteLine("Test 6: Non-existent user test");
        var nonExistentUser = await authService.LoginAsync("nonexistent_user_12345", testPassword);
         
          if (nonExistentUser != null)
         {
           Debug.WriteLine("❌ Test 6 FAILED: Login succeeded for non-existent user");
        return false;
 }
   
           Debug.WriteLine("✅ Test 6 PASSED: Non-existent user correctly rejected");
    
                // Test 7: Case insensitive username test
 Debug.WriteLine("Test 7: Case insensitive username test");
      var caseInsensitiveUser = await authService.LoginAsync(testUsername.ToUpper(), testPassword);
       
    if (caseInsensitiveUser == null)
    {
       Debug.WriteLine("❌ Test 7 FAILED: Case insensitive login failed");
        return false;
        }
 
           Debug.WriteLine("✅ Test 7 PASSED: Case insensitive login successful");
 
                Debug.WriteLine("=== All Authentication Tests PASSED ===");
       return true;
            }
      catch (Exception ex)
      {
   Debug.WriteLine($"❌ Authentication test failed with exception: {ex.Message}");
    Debug.WriteLine($"Stack trace: {ex.StackTrace}");
         return false;
      }
      }
        
        /// <summary>
   /// Shows a dialog with test results for manual verification
        /// </summary>
        public static async void ShowTestDialog()
        {
         try
      {
            bool testPassed = await RunPersistenceTest();
         
              string message;
      MessageBoxIcon icon;
 
          if (testPassed)
 {
         message = "✅ All authentication persistence tests PASSED!\n\n" +
            "This confirms:\n" +
        "• User registration saves to SQLite database\n" +
         "• Password hashing works correctly\n" +
       "• Login retrieves and verifies users properly\n" +
     "• Database persists between operations\n" +
          "• Case insensitive username lookup works\n" +
"• Password verification prevents wrong passwords\n\n" +
           $"Database location: {AppPaths.DbFilePath}";
         icon = MessageBoxIcon.Information;
      }
         else
         {
             message = "❌ Authentication persistence tests FAILED!\n\n" +
             "Check the Debug output for detailed error information.\n\n" +
   $"Database location: {AppPaths.DbFilePath}\n" +
  $"Database info: {AppPaths.GetDatabaseInfo()}";
                 icon = MessageBoxIcon.Error;
    }

                MessageBox.Show(message, "Authentication Test Results", MessageBoxButtons.OK, icon);
            }
catch (Exception ex)
            {
   MessageBox.Show($"Test execution failed:\n{ex.Message}", 
                 "Test Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
        }
 }
    }
}
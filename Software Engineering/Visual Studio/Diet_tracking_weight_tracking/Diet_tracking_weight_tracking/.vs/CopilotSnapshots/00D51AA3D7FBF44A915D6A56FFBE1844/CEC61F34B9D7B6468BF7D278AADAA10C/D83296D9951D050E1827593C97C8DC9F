        /// <summary>
      /// Create or configure the FlowLayoutPanel for Quick Add buttons
     /// </summary>
      private void CreateOrConfigureFlowPanel()
        {
      if (flowQuickAdd == null)
   {
          flowQuickAdd = QuickAddLayoutHelpers.CreateQuickAddFlowPanel();
            
      // Replace the existing pnlQuickAdd with the new FlowLayoutPanel
     if (pnlQuickAdd != null)
      {
   var parent = pnlQuickAdd.Parent;
     var bounds = pnlQuickAdd.Bounds;
 var anchor = pnlQuickAdd.Anchor;
       var dock = pnlQuickAdd.Dock;
     
    parent.Controls.Remove(pnlQuickAdd);
          pnlQuickAdd.Dispose();
     
 // Set up the FlowLayoutPanel with the same positioning

    /// <summary>
        /// Update the calorie pie chart for a specific date
        /// Shows calorie distribution by food type
 /// </summary>
 /// <param name="date">Date to show calories for</param>
        public async Task UpdateCaloriesPieChartAsync(DateTime date)
     {
   try
    {
       // Fetch data off UI thread
       var groupedEntries = await Task.Run(() =>
          {
  using (var context = new Data.DietTrackerDbContext())
 {
       context.EnsureCreated();
  var entries = context.GetFoodEntries(_user.Id, date);
 
       if (!entries.Any())
        return new List<GroupedCaloriesDto>();

      var grouped = entries
 .GroupBy(f => f.FoodName)
    .Select(g => new GroupedCaloriesDto
        {
  Food = g.Key,
   Calories = g.Sum(x => x.Calories)
 })
     .OrderByDescending(g => g.Calories)
      .ToList();

     // Calculate percentages
       var totalCalories = grouped.Sum(g => g.Calories);
   foreach (var item in grouped)
{
        item.Percentage = totalCalories > 0 ? (double)item.Calories / totalCalories * 100 : 0;
       }

     return grouped;
    }
     });

          // Update UI on main thread
       if (this.InvokeRequired)
     {
    this.BeginInvoke(new Action(() => UpdateCaloriesPieChartInternal(groupedEntries, date)));
            }
            else
     {
           UpdateCaloriesPieChartInternal(groupedEntries, date);
    }
        }
   catch (Exception ex)
        {
      if (this.InvokeRequired)
   {
      this.BeginInvoke(new Action(() => 
 ShowChartError(picCalories, "Error loading calorie data")));
      }
     else
 {
     ShowChartError(picCalories, "Error loading calorie data");
   }
   
    // Log error or show message
       Console.WriteLine($"Error updating calorie chart: {ex.Message}");
        }
      }

        /// <summary>
        /// Internal method to update pie chart on UI thread
/// </summary>
    private void UpdateCaloriesPieChartInternal(List<GroupedCaloriesDto> groupedEntries, DateTime date)
   {
      var title = $"Calorie Distribution - {date:MMM dd}";
        
       if (groupedEntries == null || !groupedEntries.Any())
            {
 SimpleChartHelpers.DrawPieChart(picCalories, new List<GroupedCaloriesDto>(), title);
   return;
}

       // Group small items under "Other" if percentage < 3%
        var mainItems = groupedEntries.Where(g => g.Percentage >= 3).ToList();
       var otherItems = groupedEntries.Where(g => g.Percentage < 3).ToList();

 var chartData = new List<GroupedCaloriesDto>(mainItems);
        
        // Add "Other" category if there are small items
     if (otherItems.Any())
            {
   var otherCalories = otherItems.Sum(i => i.Calories);
       var totalCalories = groupedEntries.Sum(g => g.Calories);
   var otherPercentage = (double)otherCalories / totalCalories * 100;
      
     chartData.Add(new GroupedCaloriesDto
       {
    Food = "Other",
 Calories = otherCalories,
           Percentage = otherPercentage
      });
            }

      // Use the enhanced circular pie chart rendering
      SimpleChartHelpers.DrawPieChart(picCalories, chartData, title);
        }

   /// <summary>
        /// Update the weight line chart for a date range
    /// Shows weight trend over time
     /// </summary>
        /// <param name="fromDate">Start date</param>
        /// <param name="toDate">End date</param>
   public async Task UpdateWeightLineChartAsync(DateTime fromDate, DateTime toDate)
        {
     try
     {
    // Fetch data off UI thread
        var weightEntries = await Task.Run(() =>
    {
    using (var context = new Data.DietTrackerDbContext())
        {
      context.EnsureCreated();
       var entries = context.GetWeightEntries(_user.Id, fromDate, toDate);
     
       return entries.Select(w => new WeightChartDto
          {
          Timestamp = w.Timestamp,
   WeightKg = w.WeightKg
     }).OrderBy(w => w.Timestamp).ToList();
        }
    });

    // Update UI on main thread
     if (this.InvokeRequired)
      {
       this.BeginInvoke(new Action(() => UpdateWeightLineChartInternal(weightEntries, fromDate, toDate)));
     }
   else
    {
      UpdateWeightLineChartInternal(weightEntries, fromDate, toDate);
         }
 }
         catch (Exception ex)
        {
     if (this.InvokeRequired)
      {
          this.BeginInvoke(new Action(() => 
 ShowChartError(picWeight, "Error loading weight data")));
     }
 else
   {
          ShowChartError(picWeight, "Error loading weight data");
      }

      Console.WriteLine($"Error updating weight chart: {ex.Message}");
            }
        }

        /// <summary>
      /// Internal method to update line chart on UI thread
      /// </summary>
     private void UpdateWeightLineChartInternal(List<WeightChartDto> weightEntries, DateTime fromDate, DateTime toDate)
        {
        var daySpan = (toDate - fromDate).Days;
      var title = $"Weight History - Last {daySpan} Days";
            
     SimpleChartHelpers.DrawLineChart(picWeight, weightEntries, title);
        }

   /// <summary>
     /// Show an error message on a chart PictureBox
        /// </summary>
        private void ShowChartError(PictureBox pictureBox, string message)
        {
      var bitmap = new Bitmap(pictureBox.Width, pictureBox.Height);
       using (var graphics = Graphics.FromImage(bitmap))
            {
       graphics.Clear(Color.White);
     using (var font = new Font("Segoe UI", 11, FontStyle.Italic))
     using (var brush = new SolidBrush(Color.Red))
     {
     var size = graphics.MeasureString(message, font);
         var x = (pictureBox.Width - size.Width) / 2;
  var y = (pictureBox.Height - size.Height) / 2;
        graphics.DrawString(message, font, brush, x, y);
      }
         }
   pictureBox.Image?.Dispose();
        pictureBox.Image = bitmap;
  }


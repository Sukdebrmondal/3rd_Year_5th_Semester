using System;
using Diet_tracking_weight_tracking.Data;
using Diet_tracking_weight_tracking.Models;
using Diet_tracking_weight_tracking.Services;

namespace Diet_tracking_weight_tracking.Data
{
    /// <summary>
    /// Database initializer that creates tables and seeds initial data
    /// </summary>
 public static class DatabaseInitializer
    {
        /// <summary>
 /// Initialize the database with tables and seed data
 /// </summary>
        public static void Initialize()
        {
            using (var context = new DietTrackerDbContext())
     {
      context.EnsureCreated();
       SeedSampleData();
   }
     }

        /// <summary>
        /// Seed sample data for demonstration
        /// </summary>
   private static void SeedSampleData()
        {
    using (var context = new DietTrackerDbContext())
          {
            context.EnsureCreated();

       // Check if users already exist
         var userCount = context.ExecuteScalar("SELECT COUNT(*) FROM Users");
          if (Convert.ToInt32(userCount) > 0) return;

      // Create a sample user
           var authService = new AuthenticationService();
       var passwordHash = authService.HashPassword("demo123");

  var user = context.CreateUser("demo", passwordHash, "demo@example.com");

    // Create sample profile
         var profile = new Profile
     {
       FullName = "Demo User",
  PhoneNumber = "1234567890",
        DOB = new DateTime(1990, 1, 1),
         Gender = Gender.Male,
       HeightCm = 175,
        WeightKg = 70.0,
         ActivityLevel = ActivityLevel.Moderate,
  HealthGoal = HealthGoal.Maintain,
   TargetWeightKg = 68.0,
       WaterTargetMl = 2000
   };

       context.SaveProfile(user.Id, profile);

     // Add sample food entries for today
           var today = DateTime.Today;
  var entries = new []
       {
   new FoodEntry { UserId = user.Id, FoodItemId = 1, FoodName = "Rice", Calories = 200, Quantity = 1, Timestamp = today.AddHours(8), Note = "Breakfast" },
     new FoodEntry { UserId = user.Id, FoodItemId = 2, FoodName = "Egg", Calories = 156, Quantity = 2, Timestamp = today.AddHours(8.5), Note = "Breakfast" },
                    new FoodEntry { UserId = user.Id, FoodItemId = 3, FoodName = "Milk", Calories = 150, Quantity = 1, Timestamp = today.AddHours(10), Note = "Morning snack" }
      };

      foreach (var entry in entries)
     {
       context.AddFoodEntry(entry);
      }

  // Add sample water entries for today
         var waterEntries = new []
         {
            new WaterEntry { UserId = user.Id, Ml = 250, Timestamp = today.AddHours(9) },
   new WaterEntry { UserId = user.Id, Ml = 150, Timestamp = today.AddHours(11) }
    };

          foreach (var entry in waterEntries)
                {
         context.AddWaterEntry(entry);
                }

    // Add sample weight entries for the past week
          for (int i = 0; i < 7; i++)
            {
      var date = today.AddDays(-i);
               var weight = 70.0 + (i * 0.1); // Gradual weight change
        var weightEntry = new WeightEntry
          {
       UserId = user.Id,
  WeightKg = weight,
                  Timestamp = date.AddHours(8)
         };
    context.AddWeightEntry(weightEntry);
      }
          }
        }
    }
}
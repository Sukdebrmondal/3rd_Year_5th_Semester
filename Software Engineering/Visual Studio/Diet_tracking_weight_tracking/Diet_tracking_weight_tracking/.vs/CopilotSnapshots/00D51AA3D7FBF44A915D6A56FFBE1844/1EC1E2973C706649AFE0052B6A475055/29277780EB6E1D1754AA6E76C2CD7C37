     #region Quick Add Button Management

 /// <summary>
      /// Create or configure the FlowLayoutPanel for Quick Add buttons
     /// </summary>
      private void CreateOrConfigureFlowPanel()
        {
      if (flowQuickAdd == null)
   {
          flowQuickAdd = QuickAddLayoutHelpers.CreateQuickAddFlowPanel();
            
      // Replace the existing pnlQuickAdd with the new FlowLayoutPanel
     if (pnlQuickAdd != null)
      {
   var parent = pnlQuickAdd.Parent;
     var bounds = pnlQuickAdd.Bounds;
 var anchor = pnlQuickAdd.Anchor;
       var dock = pnlQuickAdd.Dock;
     
    parent.Controls.Remove(pnlQuickAdd);
pnlQuickAdd.Dispose();
      
        // Set up the FlowLayoutPanel with the same positioning
 flowQuickAdd.Bounds = bounds;
        flowQuickAdd.Anchor = anchor;
 flowQuickAdd.Dock = dock;
     
      parent.Controls.Add(flowQuickAdd);
   flowQuickAdd.BringToFront();
   }
   }
}

      /// <summary>
  /// Populate Quick Add buttons from food items
   /// </summary>
      private async Task PopulateQuickAddButtons()
     {
     if (flowQuickAdd == null || _foodItems == null) return;

            flowQuickAdd.Controls.Clear();
  
   // Default food items for quick add (or use all available food items)
      var quickAddFoods = _foodItems.Where(f => 
   new[] { "Rice", "Egg", "Milk", "Fish", "Potato", "Butter", "Bread", "Apple", 
  "Chicken Breast", "Banana", "Broccoli", "Pasta" }.Contains(f.Name, StringComparer.OrdinalIgnoreCase))
      .ToList();

 // If we don't have enough predefined foods, take the first 12
            if (quickAddFoods.Count < 8)
        {
      quickAddFoods = _foodItems.Take(12).ToList();
            }

            foreach (var food in quickAddFoods)
        {
  var btn = QuickAddLayoutHelpers.CreateQuickAddButton(
          food, 
 food.Name, 
   food.DefaultCaloriesPerServing, 
     QuickAddButton_Click);
    
    flowQuickAdd.Controls.Add(btn);
          }

        // Add a "View All" button if there are more foods
      if (_foodItems.Count > quickAddFoods.Count)
   {
          var viewAllBtn = new Button
       {
        Text = "View All\nFoods",
   Size = new Size(110, 60),
        Margin = new Padding(6),
    FlatStyle = FlatStyle.Flat,
     BackColor = Color.FromArgb(108, 117, 125), // Gray color
        ForeColor = Color.White,
       Font = new Font("Segoe UI", 9, FontStyle.Bold),
         TextAlign = ContentAlignment.MiddleCenter
   };
         viewAllBtn.FlatAppearance.BorderSize = 0;
       viewAllBtn.Click += ViewAllFoodsButton_Click;
    
     flowQuickAdd.Controls.Add(viewAllBtn);
       }
        }


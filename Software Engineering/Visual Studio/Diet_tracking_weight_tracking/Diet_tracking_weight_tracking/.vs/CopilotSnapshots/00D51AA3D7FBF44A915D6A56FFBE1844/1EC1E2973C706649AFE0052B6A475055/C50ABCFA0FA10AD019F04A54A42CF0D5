  private async Task LoadFoodEntriesForTodayAsync()
        {
            try
    {
            var entries = await _entryService.GetFoodEntriesForDateAsync(_user.Id, DateTime.Today);
    
  dgvFoodEntries.Rows.Clear();
     foreach (var entry in entries.OrderBy(e => e.Timestamp))
       {
 dgvFoodEntries.Rows.Add(
         entry.FoodName, 
         entry.Calories, 
          entry.Quantity.ToString("F1"), 
          entry.Timestamp.ToString("HH:mm"),
 entry.Id
     );
    }

                UpdateFoodTotals();
    }
            catch (Exception ex)
  {
       MessageBox.Show($"Error loading food entries: {ex.Message}", "Error", 
                MessageBoxButtons.OK, MessageBoxIcon.Error);
       }
        }


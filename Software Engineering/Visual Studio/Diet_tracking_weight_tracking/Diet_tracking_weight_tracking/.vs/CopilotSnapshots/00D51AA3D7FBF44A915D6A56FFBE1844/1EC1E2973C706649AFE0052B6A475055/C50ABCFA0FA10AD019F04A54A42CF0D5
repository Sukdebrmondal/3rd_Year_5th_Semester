   #region Helper Methods

        private void UpdateFoodTotals()
        {
          int totalCalories = 0;
          foreach (DataGridViewRow row in dgvFoodEntries.Rows)
       {
   if (row.Cells["Calories"].Value != null)
 {
              if (int.TryParse(row.Cells["Calories"].Value.ToString(), out int calories))
         {
          totalCalories += calories;
      }
      }
            }
     lblCalorieTotal.Text = $"Total: {totalCalories} calories";
      }

        private async Task UpdateWaterTotals()
        {
   int totalWater = 0;
            foreach (DataGridViewRow row in dgvWaterEntries.Rows)
         {
     if (row.Cells["Amount"].Value != null)
            {
     var amountStr = row.Cells["Amount"].Value.ToString().Replace(" ml", "");
     if (int.TryParse(amountStr, out int ml))
        {
                  totalWater += ml;
        }
      }
          }

            int target = _userProfile?.WaterTargetMl ?? 2000;
            lblWaterTotal.Text = $"{totalWater} / {target} ml";
            
         // Update progress bar
  double progress = Math.Min(100, (double)totalWater / target * 100);
        progressWater.Value = (int)progress;
        }

        private void ShowSuccessMessage(string message)
        {
         // Simple success feedback - could be enhanced with a temporary status label
        var timer = new Timer { Interval = 3000 };
            var originalText = this.Text;
  this.Text = message;
      timer.Tick += (s, e) => 
  {
       this.Text = originalText;
  timer.Dispose();
            };
         timer.Start();
        }

